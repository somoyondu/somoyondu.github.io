NODE_ENV=development
PORT=4000
API_PREFIX=api/v1

# MongoDB Atlas
MONGODB_URI=mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/somoyon?retryWrites=true&w=majority

# JWT
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars-long
JWT_ACCESS_TTL=15m
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_REFRESH_TTL=7d

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=000000000000000
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_ROOT_FOLDER=somoyon

# CORS (comma separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,https://somoyondu.netlify.app

# Throttling
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# Cache
CACHE_TTL=300

# Mail (password reset + contact notification)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Somoyon <somoyon.du@gmail.com>"
CONTACT_NOTIFY_TO=somoyon.du@gmail.com

# Bootstrap super admin (used by npm run seed:admin)
SEED_ADMIN_EMAIL=admin@somoyon.org
SEED_ADMIN_PASSWORD=ChangeMe#2026
SEED_ADMIN_NAME=Super Admin

# Swagger protection in production
SWAGGER_USER=somoyon
SWAGGER_PASSWORD=change-me

# Google Sign-In (admin panel). Only emails that already exist as an active
# user in the `users` collection are allowed through — everyone else is denied.
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# Optional extra guard: comma-separated allowlist. Leave empty to rely solely
# on the users collection.
GOOGLE_ALLOWED_EMAILS=
# Optional: restrict to a Google Workspace domain, e.g. somoyon.org
GOOGLE_HOSTED_DOMAIN=
